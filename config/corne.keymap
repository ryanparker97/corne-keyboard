#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LWR RSE>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // LAYER 0: DEF - Windows Corne v4 QWERTY.
            // Binding order after the 36 finger keys is the six physical thumbs:
            // left outer->inner: LALT, RAISE, SPACE; right inner->outer: RWIN, LOWER, ENTER.
            // This puts Space on the inner-left thumb and the Windows key (RWIN) on the inner-right thumb.
            // -----------------------------------------------------------------------------------------
            // | ESC  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | CAPS |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | CTRL |
            //                    | ALT | RSE | SPC |   | WIN | LWR | RET |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp CAPS   &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LCTRL
                         &kp LALT  &mo RSE  &kp SPACE    &kp RWIN  &mo LWR  &kp RET
            >;
        };

        lower_layer {
            // LAYER 1: LWR - numbers, function keys, navigation, and mirrored physical thumbs.
            // -----------------------------------------------------------------------------------------
            // |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8   |  9  |  0  | DEL  |
            // | TAB  | F1  | F2  | F3  | F4  | F5  |   | LFT | DWN  |  UP  | RGT | PGD |      |
            // | SHFT | F6  | F7  | F8  | F9  | F10 |   | HOM | PGDN | PGUP | END | F11 | F12  |
            //                    | ALT | RSE | SPC |   | WIN | LWR | RET |

            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6    &kp N7     &kp N8     &kp N9     &kp N0   &kp DEL
&kp TAB    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp PG_DN  &trans
&trans     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp F11  &kp F12
                           &kp LALT  &mo RSE  &kp SPACE     &kp RWIN  &mo LWR  &kp RET
            >;
        };

        raise_layer {
            // LAYER 2: RSE - symbols, paired punctuation, editor resize chords, and mirrored thumbs.
            // -----------------------------------------------------------------------------------------
            // |  ~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &   |  *   |  (  |  )  |  ?   |
            // | ESC  |  -  |  =  |  [  |  ]  |  \\  |   | C-L | C-D  | C-U  | C-R |  :  |  "   |
            // | SHFT |  _  |  +  |  {  |  }  |  |  |   | HOM | PGDN | PGUP | END |  <  |  >   |
            //                    | ALT | RSE | SPC |   | WIN | LWR | RET |

            bindings = <
&kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp QUESTION
&kp ESC    &kp MINUS  &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH     &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &kp COLON  &kp DQT
&trans     &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp LT     &kp GT
                              &kp LALT  &mo RSE  &kp SPACE       &kp RWIN  &mo LWR  &kp RET
            >;
        };

        adjust_layer {
            // LAYER 3: ADJ - Bluetooth, Windows utilities, media, output selection, and system controls.
            // Activated by holding Lower + Raise together.
            // Windows utility top-right order: Y Print Screen, U Win+Shift+S, I Win+V, O Win+S, P Win+Tab, Backspace Win+L.
            // Media right home order: H previous, J play/pause, K next, L mute, ; volume down, ' volume up.
            // Output bottom-right order: N USB, M BLE, , TOG; bootloader/reset stay on / and Ctrl.
            // -------------------------------------------------------------------------------------------------
            // |      | BT1 | BT2 | BT3 | BT4 | BT5 |   | PRSC | SNIP | CLIP | SRCH | TASK | LOCK |
            // | BTCLR|     |     |     |     |     |   | PREV | PLAY | NEXT | MUTE | VOLD | VOLU |
            // |      |     |     |     |     |     |   | USB  | BLE  | TOG  |      | BOOT | RESET|
            //                         | ALT | RSE | SPC |   | WIN | LWR | RET |

            bindings = <
              &trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp PSCRN       &kp LG(LS(S))  &kp LG(V)       &kp LG(S)       &kp LG(TAB)    &kp LG(L)
&bt BT_CLR  &trans        &trans        &trans        &trans        &trans          &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP
&trans      &trans        &trans        &trans        &trans        &trans          &out OUT_USB    &out OUT_BLE    &out OUT_TOG    &trans          &bootloader     &sys_reset
                                        &kp LALT      &mo RSE       &kp SPACE       &kp RWIN        &mo LWR         &kp RET
            >;
        };
    };
};
