#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LWR RSE>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // LAYER 0: DEF - macOS Corne QWERTY
            // Karabiner maps the left pinky Caps Lock key to Hyper when held and Escape when tapped.
            // -----------------------------------------------------------------------------------------
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | CAPS |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | CTRL |
            //                    | OPT | LWR | SPC |   | GUI | RSE | ENT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp CAPS   &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LCTRL
                         &kp LALT  &mo 1  &kp SPACE    &kp LGUI  &mo 2  &kp RET
            >;
        };

        lower_layer {
            // LAYER 1: LWR - numbers, function keys, navigation, and Mac Option
            // Hold the left pinky Caps key with H/J/K/L, 1-5, or arrows for verified skhd/yabai Hyper controls.
            // -----------------------------------------------------------------------------------------
            // |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8   |  9  |  0  | DEL  |
            // | ESC  | F1  | F2  | F3  | F4  | F5  |   | LFT | DWN  |  UP  | RGT | PGU |      |
            // | OPT  | F6  | F7  | F8  | F9  | F10 |   | HOM | PGDN | PGUP | END | F11 | F12  |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6    &kp N7     &kp N8     &kp N9     &kp N0   &kp DEL
&kp ESC    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp PG_UP  &trans
&kp LALT   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp F11  &kp F12
                           &trans  &trans  &trans     &trans    &trans     &trans
            >;
        };

        raise_layer {
            // LAYER 2: RSE - symbols, paired punctuation, and editor window-resize chords
            // -----------------------------------------------------------------------------------------
            // |  ~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &   |  *   |  (  |  )  | BSPC |
            // | ESC  |  -  |  =  |  [  |  ]  |  \\  |   | C-L | C-D  | C-U  | C-R |  :  |  "   |
            // | OPT  |  _  |  +  |  {  |  }  |  |  |   | HOM | PGDN | PGUP | END |  <  |  >   |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp BSPC
&kp ESC    &kp MINUS  &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH     &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &kp COLON  &kp DQT
&kp LALT   &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp LT     &kp GT
                              &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        adjust_layer {
            // LAYER 3: ADJ - Bluetooth and system controls
            // Activated by holding Lower and Raise together.
            // -----------------------------------------------------------------------------------------
            // |      | BT1 | BT2 | BT3 | BT4 | BT5 |   |      |      |      |      |      |      |
            // | BTCLR| CAPS| GUI | OPT | CTRL| SHFT|   |      |      |      |      |      |      |
            // |      |     |     |     |     |     |   |      |      |      |      | BOOT | RESET|
            //                    |     |     |     |   |      |      |      |

            bindings = <
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans       &trans
&bt BT_CLR  &kp CAPS      &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHFT       &trans  &trans  &trans  &trans  &trans       &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &bootloader  &sys_reset
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
