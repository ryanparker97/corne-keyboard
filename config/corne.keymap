#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    macros {
        /* Prefix macros release Control before Vim/tmux receives the next key. */
        vim_window_prefix: vim_window_prefix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LC(W)>;
        };

        tmux_prefix: tmux_prefix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            /* BASE: plain QWERTY with dedicated macOS modifiers; no tap/hold keys.
             * | ESC  Q    W    E    R    T | Y    U    I    O    P    BSPC |
             * | TAB  A    S    D    F    G | H    J    K    L    ;    '    |
             * | SHFT Z    X    C    V    B | N    M    ,    .    /    CTRL |
             *              | OPT  RSE  CMD | SPC  LWR  RET |
             */
            bindings = <
&kp ESC    &kp Q          &kp W         &kp E         &kp R          &kp T        &kp Y  &kp U          &kp I         &kp O         &kp P           &kp BSPC
&kp TAB    &kp A          &kp S         &kp D         &kp F          &kp G        &kp H  &kp J          &kp K         &kp L         &kp SEMI        &kp SQT
&kp LSHFT  &kp Z          &kp X         &kp C         &kp V          &kp B        &kp N  &kp M          &kp COMMA     &kp DOT       &kp FSLH        &kp RCTRL
                                &kp LALT   &mo RAISE  &kp LGUI       &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        lower_layer {
            display-name = "Nav/Num";

            /* LOWER: numbers, released prefixes, macOS navigation, and F-keys.
             * VIM taps C-W; TMUX taps the stock C-B prefix. H/J/K/L are arrows.
             * | `    1    2    3    4    5 | 6    7    8    9    0    DEL  |
             * | VIM  CTRL OPT  CMD  SHFT TMUX| LEFT DOWN UP  RGHT PGDN PGUP |
             * | F1   F2   F3   F4   F5   F6| F7   F8   F9   F10  F11  F12  |
             *              | CTRL RSE  CMD | SPC  LWR  RET |
             */
            bindings = <
&kp GRAVE           &kp N1     &kp N2    &kp N3    &kp N4     &kp N5          &kp N6    &kp N7    &kp N8  &kp N9     &kp N0     &kp DEL
&vim_window_prefix  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &tmux_prefix    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp PG_DN  &kp PG_UP
&kp F1              &kp F2     &kp F3    &kp F4    &kp F5     &kp F6          &kp F7    &kp F8    &kp F9  &kp F10    &kp F11    &kp F12
                                           &kp LCTRL  &mo RAISE  &kp LGUI               &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        raise_layer {
            display-name = "Symbols";

            /* RAISE: Python/data/ops symbols with immediate, ordinary modifiers.
             * Python/data structures and YAML operators use the right home row.
             * | ~    !    @    #    $    % | ^    &    *    (    )    ?    |
             * | -    CTRL OPT  CMD  SHFT = | [    {    :    |    }    ]    |
             * | \     '    "    _    +    ` | <    >    ,    .    /    ;    |
             *              | CTRL RSE  CMD | SPC  LWR  RET |
             */
            bindings = <
&kp TILDE  &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR   &kp QUESTION
&kp MINUS  &kp LCTRL  &kp LALT  &kp LGUI   &kp LSHFT  &kp EQUAL    &kp LBKT   &kp LBRC   &kp COLON  &kp PIPE  &kp RBRC   &kp RBKT
&kp BSLH   &kp SQT    &kp DQT   &kp UNDER  &kp PLUS   &kp GRAVE    &kp LT     &kp GT     &kp COMMA  &kp DOT   &kp FSLH   &kp SEMI
                                  &kp LCTRL  &mo RAISE  &kp LGUI              &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        adjust_layer {
            display-name = "System";

            /* ADJUST: hold LOWER + RAISE.
             * CAP opens macOS's screenshot/recording UI; CWORD is Caps Word.
             * | BOOT BT1  BT2  BT3  BT4  BT5 | CAP  CWORD CAPS SPOT APP LOCK |
             * | BTCLR PREV PLAY NEXT MUTE VOL-| TOG  FX+   HUE+ SAT+ BRI+ SPD+|
             * | RESET DISP- DISP+ USB BLE VOL+| OUT  FX-   HUE- SAT- BRI- SPD-|
             *              | CTRL RSE  CMD | SPC  LWR  RET |
             */
            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LG(LS(N5))   &caps_word       &kp CAPS         &kp LG(SPACE)    &kp LG(TAB)      &kp LC(LG(Q))
&bt BT_CLR   &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_MUTE    &kp C_VOL_DN    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI
&sys_reset   &kp C_BRI_DN  &kp C_BRI_UP  &out OUT_USB  &out OUT_BLE  &kp C_VOL_UP    &out OUT_TOG     &rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD
                                         &kp LCTRL     &mo RAISE       &kp LGUI        &kp SPACE        &mo LOWER        &kp RET
            >;
        };
    };
};

/* Fully populated Corne v3.1: 27 LEDs and low-latency 3 ms scanning per half. */
&led_strip {
    chain-length = <27>;
};

&kscan0 {
    debounce-press-ms = <3>;
    debounce-release-ms = <3>;
};
