#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {
    behaviors {
        // Bilateral home-row modifiers: 120+ WPM prose profile. A 250 ms prior-idle
        // gate resolves active letter rolls as taps; balanced opposite-hand release
        // keeps deliberate chords usable. The 300 ms term requires a deliberate hold;
        // 175 ms quick-tap keeps repeated letter taps responsive.
        hm_l: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <250>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Right half: rows 0-2 (6-11, 18-23, 30-35), then thumbs (39-41).
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hm_r: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <250>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Left half: rows 0-2 (0-5, 12-17, 24-29), then thumbs (36-38).
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LWR RSE>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // LAYER 0: DEF - Windows Corne QWERTY with bilateral home-row modifiers.
            // Caps Lock is a plain key; no host remapper is required. Tap/hold: A Ctrl,
            // S Alt, D Win, F Shift; J Shift, K Win, L Alt, ; Ctrl.
            // -----------------------------------------------------------------------------------------
            // | ESC  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | CAPS |A/Ctrl|S/Alt|D/Win|F/Shft| G  |   |  H  |J/Shft|K/Win|L/Alt|;/Ctrl|  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | CTRL |
            //                    | ALT | RSE | WIN |   | SPC | LWR | RET |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp CAPS   &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &hm_l LSHFT F  &kp G      &kp H  &hm_r RSHFT J  &hm_r RGUI K      &hm_r RALT L    &hm_r RCTRL SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LCTRL
                         &kp LALT  &mo 2  &kp LGUI    &kp SPACE  &mo 1  &kp RET
            >;
        };

        lower_layer {
            // LAYER 1: LWR - numbers, function keys, navigation, and Alt.
            // -----------------------------------------------------------------------------------------
            // |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8   |  9  |  0  | DEL  |
            // | TAB  | F1  | F2  | F3  | F4  | F5  |   | LFT | DWN  |  UP  | RGT | PGU |      |
            // | ALT  | F6  | F7  | F8  | F9  | F10 |   | HOM | PGDN | PGUP | END | F11 | F12  |
            //                    | CTRL|     |     |   |     |     |     |

            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6    &kp N7     &kp N8     &kp N9     &kp N0   &kp DEL
&kp TAB    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp PG_UP  &trans
&kp LALT   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp F11  &kp F12
                           &kp LCTRL  &trans  &trans     &trans    &trans     &trans
            >;
        };

        raise_layer {
            // LAYER 2: RSE - symbols, paired punctuation, and Ctrl-arrow editing/navigation chords
            // -----------------------------------------------------------------------------------------
            // |  ~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &   |  *   |  (  |  )  |  ?   |
            // | ESC  |  -  |  =  |  [  |  ]  |  \\  |   | C-L | C-D  | C-U  | C-R |  :  |  "   |
            // | ALT  |  _  |  +  |  {  |  }  |  |  |   | HOM | PGDN | PGUP | END |  <  |  >   |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp QUESTION
&kp ESC    &kp MINUS  &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH     &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &kp COLON  &kp DQT
&kp LALT   &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp LT     &kp GT
                              &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        adjust_layer {
            // LAYER 3: ADJ - Bluetooth, Windows shortcuts, and system controls
            // Activated by holding Lower + Raise together.
            // Windows: Print Screen, Snipping Tool, clipboard history, search, task view, and lock.
            // --------------------------------------------------------------------------------------
            // |      | BT1 | BT2 | BT3 | BT4 | BT5 |   | PSCRN| SNIP | CLIP| SRCH | TASK| LOCK |
            // | BTCLR| ALL | SAVE| RUN | FIND| SNAP-L|SNAP-R|     |     |     |      |     |      |
            // |      | UNDO| CUT | COPY| PASTE| REDO|  |      |      |     |      | BOOT| RESET|
            //                         |     |     |     |   |     |     |     |

            bindings = <
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp PSCRN       &kp LG(LS(S))   &kp LG(V)       &kp LG(S)      &kp LG(TAB)  &kp LG(L)
&bt BT_CLR  &kp LC(A)     &kp LC(S)     &kp LG(R)     &kp LC(F)     &kp LG(LEFT)    &kp LG(RIGHT)   &trans           &trans           &trans          &trans        &trans
&trans      &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(LS(Z))   &trans           &trans           &trans           &trans          &bootloader  &sys_reset
                                        &trans        &trans        &trans          &trans           &trans           &trans
            >;
        };
    };
};
