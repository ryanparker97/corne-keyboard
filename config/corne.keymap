/*
 * Windows-oriented 42-key Corne keymap.
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    behaviors {
        /* Opposite-hand triggers make same-hand rolls tap and cross-hand chords hold. */
        hm_l: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41
            >;
            hold-trigger-on-release;
        };

        hm_r: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38
            >;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            /*
             * | ESC  Q    W    E    R    T | Y    U    I    O    P    BSPC |
             * | TAB  A/C  S/A  D/W  F/Sh G | H    J/Sh K/W  L/A  ;/C  '    |
             * | SHFT Z    X    C    V    B | N    M    ,    .    /    CTRL |
             *              | ALT  RSE  CTRL | SPC  LWR  RET |
             */
            bindings = <
&kp ESC    &kp Q          &kp W         &kp E         &kp R          &kp T        &kp Y  &kp U          &kp I         &kp O         &kp P           &kp BSPC
&kp TAB    &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &hm_l LSHFT F  &kp G        &kp H  &hm_r RSHFT J  &hm_r RGUI K  &hm_r RALT L  &hm_r RCTRL SEMI  &kp SQT
&kp LSHFT  &kp Z          &kp X         &kp C         &kp V          &kp B        &kp N  &kp M          &kp COMMA     &kp DOT       &kp FSLH        &kp RCTRL
                                &kp LALT  &mo RAISE  &kp LCTRL       &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        /* Layer CAGS keys are immediate plain modifiers, not timed mod-taps. */
        lower_layer {
            /*
             * | `    1    2    3    4    5 | 6    7    8    9    0    DEL  |
             * | LEFT CTL  ALT  WIN  SHFT DN| UP   SHFT WIN  ALT  CTL  RGHT |
             * | F1   F2   F3   F4   F5  F6| F7   F8   F9   F10  F11  F12  |
             *              | ALT  RSE  CTRL | SPC  LWR  RET |
             */
            bindings = <
&kp GRAVE  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5      &kp N6  &kp N7     &kp N8    &kp N9    &kp N0     &kp DEL
&kp LEFT   &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &kp DOWN    &kp UP  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &kp RIGHT
&kp F1     &kp F2     &kp F3    &kp F4    &kp F5     &kp F6      &kp F7  &kp F8     &kp F9    &kp F10   &kp F11    &kp F12
                                  &kp LALT  &mo RAISE  &kp LCTRL          &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        raise_layer {
            /*
             * | ~    !    @    #    $    % | ^    &    *    (    )    ?    |
             * | -    CTL  ALT  WIN  SHFT = | [    SHFT WIN  ALT  CTL  ]    |
             * | \\    :    "    _    +    { | }    |    <    >    TASK EMOJI |
             *              | ALT  RSE  CTRL | SPC  LWR  RET |
             */
            bindings = <
&kp TILDE  &kp EXCL    &kp AT    &kp HASH  &kp DLLR    &kp PRCNT    &kp CARET  &kp AMPS    &kp STAR  &kp LPAR  &kp RPAR     &kp QUESTION
&kp MINUS  &kp LCTRL   &kp LALT  &kp LGUI  &kp LSHFT   &kp EQUAL    &kp LBKT   &kp RSHFT   &kp RGUI  &kp RALT  &kp RCTRL    &kp RBKT
&kp BSLH   &kp COLON   &kp DQT   &kp UNDER &kp PLUS    &kp LBRC     &kp RBRC   &kp PIPE    &kp LT    &kp GT    &kp LG(TAB)  &kp LG(DOT)
                                  &kp LALT  &mo RAISE  &kp LCTRL             &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        adjust_layer {
            /* Lower + Raise
             * | BOOT BT1  BT2  BT3  BT4  BT5 | PSCR SNIP SRCH DSK- DSK+ LOCK |
             * | CLR  PREV PLAY NEXT MUTE VOLD| ---- ---- ---- CAPS ---- ---- |
             * | RSET BRT- BRT+ USB  BLE  VOLU| OUT  ---- ---- ---- ---- ---- |
             *              | ALT  RSE  CTRL | SPC  LWR  RET |
             */
            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp PSCRN       &kp LG(LS(S))      &kp LG(S)  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))  &kp LG(L)
&bt BT_CLR   &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_MUTE    &kp C_VOL_DN    &none           &none               &none      &kp CAPS           &none              &none
&sys_reset   &kp C_BRI_DN  &kp C_BRI_UP  &out OUT_USB  &out OUT_BLE  &kp C_VOL_UP    &out OUT_TOG    &none               &none      &none              &none              &none
                                         &kp LALT      &mo RAISE     &kp LCTRL       &kp SPACE        &mo LOWER           &kp RET
            >;
        };
    };
};
