#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3
#define WM     4

/* Hyper = Ctrl + Alt + Cmd + Shift. skhd also knows it as `hyper`.
 * HYPER is the bare modifier chord (held by TAB/HYP); HY(k) is hyper + key. */
#define HYPER LC(LA(LG(LSHFT)))
#define HY(k) LC(LA(LG(LS(k))))

/ {
    behaviors {
        /* Left outer home key, same on every layer: tap for Tab, hold for
         * Hyper. require-prior-idle-ms makes Tab resolve instantly while
         * typing; the hold is decided by the next key or the tapping term. */
        hyper_tab: hyper_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        /* Right outer thumb: hold for the WM layer, tap for Enter. */
        wm_lt: wm_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        /* The prefix macro releases Control before tmux receives the next key. */
        /* tmux prefix is C-a (see tmux/tmux.conf in the dotfiles repo). */
        tmux_prefix: tmux_prefix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LC(A)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            /* BASE: plain QWERTY with dedicated macOS modifiers.
             * TAB/HYP is the same on every layer (tap Tab, hold Hyper); WM is
             * the Enter thumb. Right Ctrl is the bottom-right key.
             * | ESC  Q    W    E    R    T | Y    U    I    O    P    BSPC |
             * | TAB/HYP A  S    D    F    G | H    J    K    L    ;    '    |
             * | SHFT Z    X    C    V    B | N    M    ,    .    /    CTRL |
             *              | OPT  RSE  CMD | SPC  LWR  RET/WM |
             */
            bindings = <
&kp ESC    &kp Q          &kp W         &kp E         &kp R          &kp T        &kp Y  &kp U          &kp I         &kp O         &kp P           &kp BSPC
&hyper_tab HYPER TAB &kp A &kp S        &kp D         &kp F          &kp G        &kp H  &kp J          &kp K         &kp L         &kp SEMI        &kp SQT
&kp LSHFT  &kp Z          &kp X         &kp C         &kp V          &kp B        &kp N  &kp M          &kp COMMA     &kp DOT       &kp FSLH        &kp RCTRL
                                &kp LALT   &mo RAISE  &kp LGUI       &kp SPACE  &mo LOWER  &wm_lt WM RET
            >;
        };

        lower_layer {
            display-name = "Nav/Num";

            /* LOWER: numbers, released prefixes, macOS navigation, and F-keys.
             * TMUX taps the C-A prefix. H/J/K/L are arrows.
             * | ESC  1    2    3    4    5 | 6    7    8    9    0    BSPC |
             * | TAB/HYP CTRL OPT CMD SHFT TMUX| LEFT DOWN UP  RGHT PGDN PGUP |
             * | F1   F2   F3   F4   F5   F6| F7   F8   F9   F10  F11  F12  |
             *              | CTRL RSE  CMD | SPC  LWR  RET |
             */
            bindings = <
&kp ESC             &kp N1     &kp N2    &kp N3    &kp N4     &kp N5          &kp N6    &kp N7    &kp N8  &kp N9     &kp N0     &kp BSPC
&hyper_tab HYPER TAB &kp LCTRL &kp LALT  &kp LGUI  &kp LSHFT  &tmux_prefix    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp PG_DN  &kp PG_UP
&kp F1              &kp F2     &kp F3    &kp F4    &kp F5     &kp F6          &kp F7    &kp F8    &kp F9  &kp F10    &kp F11    &kp F12
                                           &kp LCTRL  &mo RAISE  &kp LGUI               &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        raise_layer {
            display-name = "Symbols";

            /* RAISE: Python/data/ops symbols with immediate, ordinary modifiers.
             * Brackets are paired on the right home row with ( ) on the strongest
             * fingers; : and | sit above them.
             * | ESC  !    @    #    $    % | ^    &    *    :    |    BSPC |
             * | TAB/HYP CTRL OPT CMD SHFT = | [    (    )    {    }    ]    |
             * | \    -    "    _    +    ` | <    >    HOME END  ?    ~    |
             *              | CTRL RSE  CMD | SPC  LWR  RET |
             */
            bindings = <
&kp ESC    &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp COLON  &kp PIPE   &kp BSPC
&hyper_tab HYPER TAB &kp LCTRL &kp LALT &kp LGUI   &kp LSHFT  &kp EQUAL    &kp LBKT   &kp LPAR   &kp RPAR   &kp LBRC   &kp RBRC   &kp RBKT
&kp BSLH   &kp MINUS  &kp DQT   &kp UNDER  &kp PLUS   &kp GRAVE    &kp LT     &kp GT     &kp HOME   &kp END    &kp QUESTION  &kp TILDE
                                  &kp LCTRL  &mo RAISE  &kp LGUI              &kp SPACE  &mo LOWER  &kp RET
            >;
        };

        adjust_layer {
            display-name = "System";

            /* ADJUST: hold LOWER + RAISE.
             * CAP opens macOS's screenshot/recording UI; CWORD is Caps Word.
             * The right two rows are macOS window/screenshot shortcuts (the RGB
             * keys were dead while CONFIG_ZMK_RGB_UNDERGLOW=n).
             * | ESC  BT1  BT2  BT3  BT4  BT5 | CAP  CWORD CAPS SPOT APP  LOCK |
             * | TAB/HYP PREV PLAY NEXT MUTE VOL-| MC EXPO DT<  DT>  AREA FQUIT|
             * | RESET DISP- DISP+ USB BLE VOL+| BTCLR FULL WIN  HIDE MIN  BOOT  |
             *              | CTRL RSE  CMD | SPC  LWR  RET |
             */
            bindings = <
&kp ESC      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LG(LS(N5))   &caps_word       &kp CAPS         &kp LG(SPACE)    &kp LG(TAB)      &kp LC(LG(Q))
&hyper_tab HYPER TAB &kp C_PREV &kp C_PP     &kp C_NEXT    &kp C_MUTE    &kp C_VOL_DN    &kp LC(UP)       &kp LC(DOWN)     &kp LC(LEFT)     &kp LC(RIGHT)    &kp LG(LS(N4))   &kp LG(LA(ESC))
&sys_reset   &kp C_BRI_DN  &kp C_BRI_UP  &out OUT_USB  &out OUT_BLE  &kp C_VOL_UP    &bt BT_CLR       &kp LG(LS(N3))   &kp LG(GRAVE)    &kp LG(H)        &kp LG(M)        &bootloader
                                         &kp LCTRL     &mo RAISE       &kp LGUI        &kp SPACE        &mo LOWER        &kp RET
            >;
        };

        wm_layer {
            display-name = "WM";

            /* WM: hold the right outer thumb (Enter). Each key sends
             * hyper+<key> for skhd, at its natural QWERTY position.
             * | TAB  .    .    E    R    T | 1    2    3    4    5    .    |
             * | .    A    S    D    F    . | H    J    K    L    .    .    |
             * | .    Z    X    .    V    B | .    M    .    .    .    .    |
             *              | .    .    . | TERM .    .   |
             * (TAB = focus recent, E = resize mode, T = float, X = split,
             *  V = mirror, A = stack, D = bsp, TERM = new terminal.)
             */
            bindings = <
&kp HY(TAB)  &trans       &trans       &kp HY(E)    &kp HY(R)    &kp HY(T)    &kp HY(N1)   &kp HY(N2)   &kp HY(N3)   &kp HY(N4)   &kp HY(N5)   &trans
&trans       &kp HY(A)    &kp HY(S)    &kp HY(D)    &kp HY(F)    &trans       &kp HY(H)    &kp HY(J)    &kp HY(K)    &kp HY(L)    &trans       &trans
&trans       &kp HY(Z)    &kp HY(X)    &trans       &kp HY(V)    &kp HY(B)    &trans       &kp HY(M)    &trans       &trans       &trans       &trans
                                       &trans       &trans       &trans       &kp HY(RET)  &trans       &trans
            >;
        };
    };
};


&kscan0 {
    debounce-press-ms = <3>;
    debounce-release-ms = <3>;
};
