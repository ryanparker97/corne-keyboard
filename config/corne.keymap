#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LWR RSE>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // LAYER 0: DEF - macOS Corne QWERTY
            // Removed CAPS lock, replaced with LCTRL. Mac users traditionally map Caps to Control.
            // This groups all modifiers (Shift, Control, Option, Command) entirely on the left side.
            // -----------------------------------------------------------------------------------------
            // | ESC  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | LCTRL|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | LSHFT|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | RCTRL|
            //                    | OPT | RSE | CMD |   | SPC | LWR | RET |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                         &kp LALT  &mo RSE  &kp LGUI     &kp SPACE  &mo LWR  &kp RET
            >;
        };

        lower_layer {
            // LAYER 1: LWR - numbers, function keys, navigation, and mirrored physical thumbs.
            // -----------------------------------------------------------------------------------------
            // |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8   |  9  |  0  | DEL  |
            // | TAB  | F1  | F2  | F3  | F4  | F5  |   | LFT | DWN  |  UP  | RGT | PGD |      |
            // | SHFT | F6  | F7  | F8  | F9  | F10 |   | HOM | PGDN | PGUP | END | F11 | F12  |
            //                    | OPT | RSE | CMD |   | SPC | LWR | RET |

            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6    &kp N7     &kp N8     &kp N9     &kp N0   &kp DEL
&kp TAB    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp PG_DN  &trans
&trans     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &kp LG(LEFT) &kp PG_DN  &kp PG_UP  &kp LG(RIGHT) &kp F11  &kp F12
                           &kp LALT  &mo RSE  &kp LGUI      &kp SPACE  &mo LWR  &kp RET
            >;
        };

        raise_layer {
            // LAYER 2: RSE - symbols, paired punctuation, editor resize chords, and mirrored thumbs.
            // -----------------------------------------------------------------------------------------
            // |  ~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &   |  *   |  (  |  )  |  ?   |
            // | ESC  |  -  |  =  |  [  |  ]  |  \\  |   | C-L | C-D  | C-U  | C-R |  :  |  "   |
            // | SHFT |  _  |  +  |  {  |  }  |  |  |   | HOM | PGDN | PGUP | END |  <  |  >   |
            //                    | OPT | RSE | CMD |   | SPC | LWR | RET |

            bindings = <
&kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp QUESTION
&kp ESC    &kp MINUS  &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH     &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &kp COLON  &kp DQT
&trans     &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE     &kp LG(LEFT) &kp PG_DN  &kp PG_UP  &kp LG(RIGHT) &kp LT     &kp GT
                              &kp LALT  &mo RSE  &kp LGUI        &kp SPACE  &mo LWR  &kp RET
            >;
        };

        adjust_layer {
            // LAYER 3: ADJ - Bluetooth, RGB, Output, System Controls, and Native Mac Media Keys.
            // -------------------------------------------------------------------------------------------------
            // | BOOT | BT1 | BT2 | BT3 | BT4 | BT5 |   | SCRN | AREA | REC | SPOT | APP | LOCK |
            // | BTCLR| PREV| PLAY| NEXT| MUTE| VOLD|   | RGBT | RGBEF|RGBHU|RGBSA|RGBBR|RGBSP|
            // | RESET| BRTD| BRTU| USB | BLE | VOLU|   | OUTG | RGBER|RGBHD|RGBSD|RGBBD|RGBSM|
            //                         | OPT | RSE | CMD |   | SPC | LWR | RET |

            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LG(LS(N3))   &kp LG(LS(N4))   &kp LG(LS(N5))   &kp LG(SPACE)    &kp LG(TAB)      &kp LC(LG(Q))
&bt BT_CLR   &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_MUTE    &kp C_VOL_DN    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI
&sys_reset   &kp C_BRI_DN  &kp C_BRI_UP  &out OUT_USB  &out OUT_BLE  &kp C_VOL_UP    &out OUT_TOG     &rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD
                                         &kp LALT      &mo RSE       &kp LGUI        &kp SPACE        &mo LWR          &kp RET
            >;
        };
    };
};

// The pinned/upstream ZMK Corne nice_nano overlay defines &led_strip.
// This keymap only overrides its chain-length for a fully LED-populated Corne v3.1:
// 42 per-key SK6812 + 12 underglow WS2812 = 27 LEDs per half.
// Change chain-length to <6> if only the six underglow LEDs are soldered on each half.
&led_strip {
    chain-length = <27>;
};

&kscan0 {
    debounce-press-ms = <3>;
    debounce-release-ms = <3>;
};

