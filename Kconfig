menu "Corne keyboard module"

config CORNE_SIMPLE_OLED_STATUS_SCREEN
    bool "Corne simple OLED status screen"
    depends on ZMK_DISPLAY
    depends on ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    help
      Enable this repository's simple LVGL OLED status screen.
      This defaults to disabled so generic module builds, including
      settings_reset, do not compile display code unless explicitly enabled.

endmenu
